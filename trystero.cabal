cabal-version: 3.0
name: trystero
version: 0.1.0.0
license: BSD-3-Clause
license-file: LICENSE
copyright: Tony Day (c) 2025-2026
category: control
author: Tony Day
maintainer: tonyday567@gmail.com
homepage: https://github.com/tonyday567/trystero#readme
bug-reports: https://github.com/tonyday567/trystero/issues
synopsis: integration canary for the circuits substrate
description:
  trystero depends on every package in the circuits substrate and
  provides a green-lights executable to prove they compile and link
  together.
build-type: Simple
tested-with:
  ghc ==9.10.1
  ghc ==9.12.2
  ghc ==9.14.1
extra-doc-files:
  ChangeLog.md
  readme.md

source-repository head
  type: git
  location: https://github.com/tonyday567/trystero

common ghc-options-stanza
  ghc-options:
    -Wall
    -Wno-unused-imports
    -Wcompat
    -Widentities
    -Wincomplete-record-updates
    -Wincomplete-uni-patterns
    -Wpartial-fields
    -Wredundant-constraints

library
  import: ghc-options-stanza
  default-language: GHC2024
  hs-source-dirs: src
  exposed-modules:
    Trystero

  build-depends:
    base >=4.20 && <5,
    chart-svg >=0.8 && <0.9,
    circuits >=0.3 && <0.4,
    circuits-agent >=0.1 && <0.2,
    circuits-chu >=0.3 && <0.4,
    circuits-diagrams >=0.1 && <0.2,
    circuits-diff >=0.1 && <0.2,
    circuits-inference >=0.1 && <0.2,
    circuits-learn >=0.1 && <0.2,
    circuits-llm >=0.1 && <0.2,
    circuits-log >=0.1 && <0.2,
    circuits-mat >=0.1 && <0.2,
    circuits-meter >=0.1 && <0.2,
    circuits-parser >=0.1 && <0.2,
    circuits-pca >=0.1 && <0.2,
    circuits-rl >=0.1 && <0.2,
    circuits-stats >=0.1 && <0.2,
    formatn >=0.3 && <0.4,
    free-agent >=0.1 && <0.2,
    harpie >=0.3 && <0.4,
    manyvalued >=0.1 && <0.2,
    markup-parse >=0.3 && <0.4,
    mnet >=0.1 && <0.2,
    numhask >=0.14 && <0.15,
    numhask-space >=0.13 && <0.14,
    prettychart >=0.4 && <0.5,
    sysl >=0.1 && <0.2,
    text >=1.2 && <2.2,

executable trystero-green-lights
  import: ghc-options-stanza
  default-language: GHC2024
  hs-source-dirs: app
  main-is: GreenLights.hs
  build-depends:
    base >=4.20 && <5,
    trystero,

executable trystero-dashboard
  import: ghc-options-stanza
  default-language: GHC2024
  hs-source-dirs: app
  main-is: Dashboard.hs
  build-depends:
    base >=4.20 && <5,
    optparse-applicative >=0.17 && <0.19,
