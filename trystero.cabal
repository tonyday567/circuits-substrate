cabal-version: 3.0
name: trystero
version: 0.1.0.0
license: BSD-3-Clause
license-file: LICENSE
copyright: Tony Day (c) 2025-2026
category: control
author: Tony Day
maintainer: tonyday567@gmail.com
homepage: https://github.com/tonyday567/trystero#readme
bug-reports: https://github.com/tonyday567/trystero/issues
synopsis: integration canary for the circuits substrate
description:
  trystero depends on every package in the circuits substrate and
  provides a green-lights executable to prove they compile and link
  together.

build-type: Simple
tested-with:
  ghc ==9.14.1

extra-doc-files:
  ChangeLog.md
  readme.md

source-repository head
  type: git
  location: https://github.com/tonyday567/trystero

common ghc-options-stanza
  ghc-options:
    -Wall
    -Wno-unused-imports
    -Wcompat
    -Widentities
    -Wincomplete-record-updates
    -Wincomplete-uni-patterns
    -Wpartial-fields
    -Wredundant-constraints

library
  import: ghc-options-stanza
  default-language: GHC2024
  hs-source-dirs: src
  exposed-modules:
    Trystero

  build-depends:
    base >=4.20 && <5,
    chart-svg,
    circuits,
    circuits-agent,
    circuits-chu,
    circuits-diagrams,
    circuits-diff,
    circuits-inference,
    circuits-learn,
    circuits-llm,
    circuits-log,
    circuits-mat,
    circuits-meter,
    circuits-parser,
    circuits-pca,
    circuits-rl,
    circuits-stats,
    formatn,
    free-agent,
    harpie,
    manyvalued,
    markup-parse,
    mnet,
    numhask,
    numhask-space,
    prettychart,
    sysl,
    text,

executable trystero-green-lights
  import: ghc-options-stanza
  default-language: GHC2024
  hs-source-dirs: app
  main-is: GreenLights.hs
  build-depends:
    base >=4.20 && <5,
    trystero,

executable trystero-dashboard
  import: ghc-options-stanza
  default-language: GHC2024
  hs-source-dirs: app
  main-is: Dashboard.hs
  build-depends:
    base >=4.20 && <5,
    optparse-applicative >=0.17 && <0.19,
